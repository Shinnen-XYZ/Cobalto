# Copy to .env for local use. These credentials are for development only.
POSTGRES_PASSWORD=replace-with-a-local-development-password
COBALTO_JWT_SECRET=replace-with-base64-encoded-random-secret-of-at-least-32-bytes
COBALTO_MFA_ENCRYPTION_KEYS=replace-with-a-different-base64-encoded-random-secret-of-at-least-32-bytes
COBALTO_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
